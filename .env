# ─────────────────────────────────────────────────────────────
# Process Agentifier — Backend Environment Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────


# ── LLM Core Settings ─────────────────────────────────────────
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8192


# ── ArangoDB ──────────────────────────────────────────────────
ARANGO_HOST=http://72.61.226.68:8529
ARANGO_DB=agent
ARANGO_USERNAME=root
ARANGO_PASSWORD=Aiinhome@2026



# -- MYSQL
MYSQL_HOST=72.61.226.68
MYSQL_PORT=3306
MYSQL_USERNAME=aiinhome
MYSQL_PASSWORD=Aiin@2026
MYSQL_DB=agentforge_x



# ── Flask ─────────────────────────────────────────────────────
FLASK_ENV=production
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-this-to-a-random-secret-key
FLASK_HOST=127.0.0.1
FLASK_PORT=3006


# ── CORS — Frontend Origins ───────────────────────────────────
# Comma-separated list of allowed frontend URLs (no trailing slash).
# Examples:
#   Single domain:    https://app.yourdomain.com
#   Multiple:         https://app.yourdomain.com,http://192.168.1.50:3000
#   Local dev:        http://localhost:3000,http://localhost:5173
#   Allow all (dev):  *
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173


# ── Upload Limits ─────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50


# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO


# ── Gunicorn (Linux only) ─────────────────────────────────────
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=180
GUNICORN_ACCESS_LOG=-
GUNICORN_ERROR_LOG=-


# ── Waitress (Windows only) ───────────────────────────────────
WAITRESS_THREADS=4

BASE_URL=http://122.163.121.176:3004

# ─────────────────────────────────────────────────────────────
# NEW — JWT
# ─────────────────────────────────────────────────────────────
JWT_SECRET_KEY=
JWT_TTL_HOURS=24

# ─────────────────────────────────────────────────────────────
# NEW — Email OTP (SMTP). Without these the OTP is logged to
# stdout and echoed in the API response (DEV only).
# ─────────────────────────────────────────────────────────────
SMTP_HOST=mail.agentforge.services
SMTP_PORT=465
SMTP_USE_TLS=true
SMTP_USERNAME=support@agentforge.services
SMTP_PASSWORD=Support@2026
SMTP_FROM_NAME=AgentForgeX
SMTP_FROM_EMAIL=support@agentforge.services
OTP_TTL_MINUTES=10

# ─────────────────────────────────────────────────────────────
# NEW — Google OAuth
# ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=401616369408-s0fk9b1s9he26okuetrn2td71jro9ku0.apps.googleusercontent.com

# ─────────────────────────────────────────────────────────────
# NEW — Razorpay
# ─────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=


DUMMY_PAYMENTS_ENABLED=true