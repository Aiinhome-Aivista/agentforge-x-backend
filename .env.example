# ─────────────────────────────────────────────────────────────
# AgentForgeX — Backend Environment Configuration (example)
# Copy to .env and fill in your values. Never commit .env.
# ─────────────────────────────────────────────────────────────

# ── Mistral LLM ───────────────────────────────────────────────
MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_MODEL=mistral-small-latest

# ── ArangoDB ──────────────────────────────────────────────────
ARANGO_HOST=http://127.0.0.1:8529
ARANGO_DB=agent
ARANGO_USERNAME=root
ARANGO_PASSWORD=change-me

# ── MySQL ─────────────────────────────────────────────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USERNAME=agentforge_x
MYSQL_PASSWORD=change-me
MYSQL_DB=agentforge_x

# ── Flask ─────────────────────────────────────────────────────
FLASK_ENV=production
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-this-to-a-random-secret-key
FLASK_HOST=127.0.0.1
FLASK_PORT=3004

# ── JWT (defaults to FLASK_SECRET_KEY when blank) ─────────────
JWT_SECRET_KEY=
JWT_TTL_HOURS=24

# ── CORS — Frontend Origins ───────────────────────────────────
# Comma-separated list of allowed frontend URLs (no trailing slash).
FRONTEND_ORIGINS=http://localhost:5173,https://agentforge.services

# ── Upload Limits ─────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50

# ── Logging ───────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Gunicorn (Linux only) ─────────────────────────────────────
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=180
GUNICORN_ACCESS_LOG=-
GUNICORN_ERROR_LOG=-

# ── Waitress (Windows only) ───────────────────────────────────
WAITRESS_THREADS=4

BASE_URL=https://agentforge.services

# ─────────────────────────────────────────────────────────────
# NEW — Email OTP (SMTP)
# ─────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your-bot@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM_NAME=AgentForgeX
SMTP_FROM_EMAIL=
OTP_TTL_MINUTES=10

# ─────────────────────────────────────────────────────────────
# NEW — Google OAuth
# Create OAuth 2.0 Client ID at:
#   https://console.cloud.google.com/apis/credentials
# Type: Web application. Authorized JS origins must include
#   https://agentforge.services (and http://localhost:5173 for dev).
# ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# ─────────────────────────────────────────────────────────────
# NEW — Razorpay
# Get keys from https://dashboard.razorpay.com/app/keys
# Use test_* during development.
# ─────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
